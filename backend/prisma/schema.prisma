generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model Post {
  id           String   @id @default(cuid())
  externalId   String   @unique @db.VarChar(512)
  source       String   @db.VarChar(32)
  authorName   String
  authorHandle String
  text         String   @db.Text
  url          String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}